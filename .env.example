# Desarrollo local: npm start. Cada persona ingresa su enlace y PAT en la pantalla.
# Publicación: definir el origen HTTPS exacto y servir Angular y /api bajo ese origen.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://flowboard.example.com
# En Render se usa RENDER_EXTERNAL_URL automáticamente si PUBLIC_ORIGIN no está definido.
# HOST=127.0.0.1
# PORT=3001
